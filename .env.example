# Odoo MCP Server Configuration
# Copy this file to .env and fill in your values

# Required
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your-database
ODOO_USERNAME=your-username

# Authentication (use API key OR password)
ODOO_API_KEY=your-api-key
# ODOO_PASSWORD=your-password

# Optional
# ODOO_TIMEOUT=30
# ODOO_VERIFY_SSL=true

# Transport (default: stdio)
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8080
# MCP_VERBOSE=true              # Slant-ASCII startup banner to stderr (false to silence)

# HTTP auth — single-user: set a static bearer token.
# HTTP server refuses to start unless MCP_API_KEY *or* USERS_DB_PATH is set.
# MCP_API_KEY=your-secret-bearer-token

# Multi-user mode (CLORAG registry) — set USERS_DB_PATH to enable.
# The registry (users.db) is owned/written by CLORAG; this server reads it (mode=ro).
# TOKEN_ENCRYPTION_KEY and the .token_salt file MUST match CLORAG's values.
# USERS_DB_PATH=/registry/users.db
# TOKEN_ENCRYPTION_KEY=must-equal-clorag-value
# TOKEN_ENCRYPTION_KEY_FILE=/run/secrets/token_encryption_key   # Docker-secret alternative

# Safety Layer (v1.10.0)
# MCP_SAFETY_MODE=strict        # strict (default) or permissive
# MCP_SAFETY_AUDIT=true         # Enable audit logging to stderr

# DX (v1.11.0)
# MCP_DEFAULT_CONTEXT={"lang": "fr_FR", "tz": "Europe/Paris"}
# MCP_BOOTSTRAP_MODELS=res.partner,sale.order,account.move,product.product,stock.picking
